{
  "env": {
    "node": true,
    "es2021": true
  },
  "extends": "airbnb-base",
  "parserOptions": {
    "ecmaVersion": 12,
    "sourceType": "module"
  },
  "rules": {
    "no-underscore-dangle": ["error", { "allow": ["_id"] }],
    "no-restricted-syntax": [
      "error",
      {
        "selector": "Program > Comment[value=/eslint-disable/i]",
        "message": "Las reglas eslint-disable están estrictamente prohibidas por la rúbrica."
      }
    ]
  }
}
